{
  "name": "photoframe-server",
  "version": "1.3.0",
  "description": "Backend for esp32-photoframe: serves Immich photos converted to Spectra-6 e-paper images",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm --prefix web run build && tsc",
    "build:server": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently --kill-others-on-fail -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aitjcize/epaper-image-convert": "^0.1.15",
    "better-sqlite3": "^12.10.0",
    "canvas": "^3.2.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  },
  "license": "MIT",
  "private": true
}
