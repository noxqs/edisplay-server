# --- Immich (required) ---
# Base origin of your Immich server, WITHOUT a trailing slash or /api.
# If Immich runs on the Docker host while this runs in a container, use:
#   IMMICH_BASE_URL=http://host.docker.internal:2283
IMMICH_BASE_URL=http://localhost:2283
# Immich API key (Account Settings -> API Keys).
IMMICH_API_KEY=replace-me

# --- Album selection (optional) ---
# Seed album id(s), comma-separated. You can also pick albums at runtime in the
# admin UI (/admin); the runtime selection is persisted and overrides this seed.
ALBUM_IDS=

# --- Device auth (optional) ---
# If set, the frame must send Authorization: Bearer <token>.
DEVICE_AUTH_TOKEN=

# --- Display defaults (used when the frame sends no X-Display-* headers) ---
DEFAULT_WIDTH=1200
DEFAULT_HEIGHT=1600
DEFAULT_ORIENTATION=portrait

# --- Conversion ---
# epaper-image-convert preset: balanced | dynamic | vivid | soft | grayscale
CONVERT_PRESET=balanced

# --- Misc (optional) ---
# Public origin used to build the X-Thumbnail-URL (set when behind a proxy).
PUBLIC_BASE_URL=
# PORT=8080
# CACHE_DIR=./cache
# CACHE_MAX_ENTRIES=500
# SETTINGS_FILE=./data/settings.json
# DB_FILE=./data/app.db
# WEB_DIST_DIR=./web/dist
# POOL_REFRESH_MS=3600000
# Tick interval (ms) for simulated devices used to test group behaviour.
# SIM_TICK_MS=20000
